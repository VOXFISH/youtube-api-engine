{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/Cache/${presetName}",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows x64 (Visual Studio 2022)",
      "description": "Requires Visual Studio C++ tools and VCPKG_ROOT. Pass -DFMOD_ROOT=<SDK folder> for a nonstandard FMOD installation.",
      "inherits": "windows-base",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "windows-vs2026",
      "displayName": "Windows x64 (Visual Studio 2026)",
      "description": "Requires Visual Studio C++ tools and VCPKG_ROOT. Pass -DFMOD_ROOT=<SDK folder> for a nonstandard FMOD installation.",
      "inherits": "windows-base",
      "generator": "Visual Studio 18 2026"
    }
  ],
  "buildPresets": [
    { "name": "build-vs2022-release", "configurePreset": "windows-vs2022", "configuration": "Release", "jobs": 4 },
    { "name": "build-vs2022-debug", "configurePreset": "windows-vs2022", "configuration": "Debug", "jobs": 4 },
    { "name": "build-vs2026-release", "configurePreset": "windows-vs2026", "configuration": "Release", "jobs": 4 },
    { "name": "build-vs2026-debug", "configurePreset": "windows-vs2026", "configuration": "Debug", "jobs": 4 }
  ],
  "testPresets": [
    { "name": "test-vs2022-release", "configurePreset": "windows-vs2022", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "test-vs2022-debug", "configurePreset": "windows-vs2022", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "test-vs2026-release", "configurePreset": "windows-vs2026", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "test-vs2026-debug", "configurePreset": "windows-vs2026", "configuration": "Debug", "output": { "outputOnFailure": true } }
  ],
  "workflowPresets": [
    {
      "name": "vs2022-release",
      "displayName": "Configure, build and test (VS 2022 Release)",
      "steps": [
        { "type": "configure", "name": "windows-vs2022" },
        { "type": "build", "name": "build-vs2022-release" },
        { "type": "test", "name": "test-vs2022-release" }
      ]
    },
    {
      "name": "vs2026-release",
      "displayName": "Configure, build and test (VS 2026 Release)",
      "steps": [
        { "type": "configure", "name": "windows-vs2026" },
        { "type": "build", "name": "build-vs2026-release" },
        { "type": "test", "name": "test-vs2026-release" }
      ]
    }
  ]
}
